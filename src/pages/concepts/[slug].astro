---
import { getCollection, render } from "astro:content";
import ArticleLayout from "@/layouts/ArticleLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("concepts");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allConcepts = await getCollection("concepts");
const relatedConcepts = entry.data.related
  .map((slug) => allConcepts.find((concept) => concept.id === slug))
  .filter((concept): concept is (typeof allConcepts)[number] => Boolean(concept));
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  category={entry.data.group}
  pubDate={entry.data.pubDate}
  readingMinutes={5}
>
  <section class="concept-summary card card-pad">
    <p><strong>一句话理解：</strong>{entry.data.plainDefinition}</p>
    <dl>
      {entry.data.english && (
        <div>
          <dt>英文术语</dt>
          <dd>{entry.data.english}</dd>
        </div>
      )}
      <div>
        <dt>分类</dt>
        <dd>{entry.data.group} · {entry.data.level}</dd>
      </div>
      {entry.data.aliases.length > 0 && (
        <div>
          <dt>常见别名</dt>
          <dd>{entry.data.aliases.join("、")}</dd>
        </div>
      )}
      {entry.data.domains.length > 0 && (
        <div>
          <dt>涉及领域</dt>
          <dd>{entry.data.domains.join("、")}</dd>
        </div>
      )}
    </dl>
    {entry.data.clinicalBoundary && <p class="clinical-note">{entry.data.clinicalBoundary}</p>}
  </section>
  <Content />
  {relatedConcepts.length > 0 && (
    <section class="concept-links">
      <h2>相关概念</h2>
      <div>
        {relatedConcepts.map((concept) => (
          <a href={`/concepts/${concept.id}/`}>
            <strong>{concept.data.title}</strong>
            <span>{concept.data.plainDefinition}</span>
          </a>
        ))}
      </div>
    </section>
  )}
  {entry.data.sourceRefs.length > 0 && (
    <section class="source-list">
      <h2>参考来源</h2>
      <ul>
        {entry.data.sourceRefs.map((source) => (
          <li><a href={source.url}>{source.label}</a></li>
        ))}
      </ul>
    </section>
  )}
</ArticleLayout>

<style>
  .concept-summary {
    margin-bottom: 28px;
    background: rgba(220, 231, 227, 0.5);
  }

  .concept-summary p {
    margin: 0;
  }

  .concept-summary dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin: 18px 0 0;
  }

  .concept-summary dt {
    color: var(--muted);
    font-size: 0.84rem;
    font-weight: 800;
  }

  .concept-summary dd {
    margin: 5px 0 0;
    color: var(--ink);
    line-height: 1.65;
  }

  .clinical-note {
    border-top: 1px solid var(--line);
    margin-top: 18px;
    padding-top: 14px;
    color: var(--muted);
    line-height: 1.75;
  }

  .concept-links {
    margin-top: 34px;
  }

  .concept-links > div {
    display: grid;
    gap: 12px;
  }

  .concept-links a {
    display: grid;
    gap: 6px;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 14px 16px;
    background: rgba(255, 250, 241, 0.72);
  }

  .concept-links span {
    color: var(--muted);
    line-height: 1.65;
  }

  .source-list {
    margin-top: 34px;
  }

  .source-list ul {
    padding-left: 20px;
  }

  .source-list li {
    margin: 8px 0;
  }

  @media (max-width: 720px) {
    .concept-summary dl {
      grid-template-columns: 1fr;
    }
  }
</style>
