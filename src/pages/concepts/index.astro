---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const concepts = (await getCollection("concepts")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, "zh-CN"),
);
const groups = [...new Set(concepts.map((entry) => entry.data.group))];
---

<BaseLayout title="心理概念词典" description="查询精神分析、人格心理学和精神动力学中的核心概念。">
  <main>
    <section class="dictionary-hero">
      <div class="container dictionary-grid">
        <div>
          <p class="eyebrow">Concept Dictionary</p>
          <h1>心理概念词典</h1>
          <p>用清晰的语言理解防御、关系、冲突与人格结构。每个词条都尽量避免把人简化成标签。</p>
          <div class="search-box" role="search">
            <span>搜索：投射、移情、防御机制…</span>
          </div>
          <div class="dictionary-guide">
            <strong>词条阅读顺序</strong>
            <span>先读一句话定义，再看关系表现，最后回到自我观察问题。</span>
          </div>
        </div>
        <div class="book-stack card" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="filter-row" aria-label="概念分类">
          <span class="pill">全部</span>
          {groups.map((group) => <span class="pill">{group}</span>)}
        </div>
        <div class="usage-grid">
          <div class="card card-pad">
            <strong>如果你从 MBTI 来</strong>
            <p>先查“防御机制”和“移情”，再回到具体类型页，会更容易看见类型背后的关系动力。</p>
          </div>
          <div class="card card-pad">
            <strong>如果你从关系问题来</strong>
            <p>先读“投射”和“重复强迫”，它们能解释很多过度反应和熟悉的痛苦模式。</p>
          </div>
          <div class="card card-pad">
            <strong>如果你在学习精神分析</strong>
            <p>把词条当作索引，而不是诊断工具。概念是为了理解经验，不是给人贴标签。</p>
          </div>
        </div>
        <div class="concept-list">
          {concepts.map((entry) => (
            <a class="concept-entry" href={`/concepts/${entry.id}/`}>
              <span class="icon" aria-hidden="true">{entry.data.title.slice(0, 1)}</span>
              <div>
                <strong>{entry.data.title}</strong>
                <p>{entry.data.plainDefinition}</p>
              </div>
              <span class="arrow" aria-hidden="true">-></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .dictionary-hero {
    padding: 60px 0 34px;
  }

  .dictionary-grid {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 36px;
    align-items: center;
  }

  h1 {
    margin: 10px 0;
    font-size: clamp(2.3rem, 5vw, 5rem);
    line-height: 1.06;
  }

  p {
    color: var(--muted);
    line-height: 1.85;
  }

  .search-box {
    margin-top: 26px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper);
    padding: 15px 18px;
    color: var(--muted);
    box-shadow: 0 12px 30px rgba(37, 67, 58, 0.08);
  }

  .dictionary-guide {
    display: grid;
    gap: 6px;
    margin-top: 14px;
    color: var(--muted);
    line-height: 1.65;
  }

  .dictionary-guide strong {
    color: var(--wine);
  }

  .book-stack {
    display: grid;
    gap: 14px;
    padding: 34px;
  }

  .book-stack span {
    height: 58px;
    border-radius: 6px;
    background: linear-gradient(90deg, var(--ink), #496a5e);
  }

  .book-stack span:nth-child(2) {
    margin-left: 28px;
    background: linear-gradient(90deg, var(--wine), #8a5264);
  }

  .book-stack span:nth-child(3) {
    margin-left: 8px;
    background: linear-gradient(90deg, var(--gold), #d1bb82);
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 22px;
  }

  .usage-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 22px;
  }

  .usage-grid strong {
    color: var(--wine);
  }

  .usage-grid p {
    margin: 8px 0 0;
    font-size: 0.94rem;
  }

  .concept-list {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: rgba(255, 250, 241, 0.78);
  }

  .concept-entry {
    display: grid;
    grid-template-columns: 52px 1fr auto;
    gap: 16px;
    align-items: center;
    border-bottom: 1px solid var(--line);
    padding: 20px;
  }

  .concept-entry:last-child {
    border-bottom: 0;
  }

  .icon {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border-radius: 8px;
    background: var(--ink);
    color: var(--paper);
    font-weight: 800;
  }

  strong {
    font-size: 1.15rem;
  }

  .concept-entry p {
    margin: 6px 0 0;
  }

  .arrow {
    color: var(--wine);
    font-weight: 800;
  }

  @media (max-width: 820px) {
    .dictionary-grid,
    .usage-grid {
      grid-template-columns: 1fr;
    }

    .concept-entry {
      grid-template-columns: 44px 1fr;
    }

    .arrow {
      display: none;
    }
  }
</style>
