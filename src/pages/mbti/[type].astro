---
import { getCollection, render } from "astro:content";
import ArticleLayout from "@/layouts/ArticleLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("mbti");
  return entries.map((entry) => ({ params: { type: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ArticleLayout
  title={entry.data.typeCode}
  description={entry.data.description}
  category="MBTI 类型档案"
  pubDate={entry.data.pubDate}
  readingMinutes={8}
>
  <div class="type-summary">
    <div>
      <strong>功能序列</strong>
      <p>{entry.data.functions.join(" · ")}</p>
    </div>
    <div>
      <strong>阅读提醒</strong>
      <p>类型描述不是诊断，也不是命运。它只是理解心理动力的一种入口。</p>
    </div>
  </div>
  <section class="profile-lens">
    <h2>快速档案</h2>
    <div class="lens-grid">
      <div>
        <span>核心需要</span>
        <strong>{entry.data.coreNeed}</strong>
      </div>
      <div>
        <span>常见压力点</span>
        <strong>{entry.data.stressPoint}</strong>
      </div>
      <div>
        <span>容易使用的防御</span>
        <strong>{entry.data.defenses.join("、")}</strong>
      </div>
    </div>
  </section>
  <section class="comparison-panel">
    <h2>不要只读 MBTI 描述</h2>
    <div class="comparison-grid">
      <div>
        <h3>类型描述会说</h3>
        <p>{entry.data.typeSays}</p>
      </div>
      <div>
        <h3>心理动力会追问</h3>
        <p>{entry.data.dynamicQuestion}</p>
      </div>
    </div>
  </section>
  <section class="cycle-panel">
    <h2>常见动力循环</h2>
    <ol>
      {entry.data.cycle.map((item) => <li>{item}</li>)}
    </ol>
  </section>
  <Content />
</ArticleLayout>

<style>
  .type-summary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin: 24px 0 34px;
  }

  .type-summary div {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(255, 250, 241, 0.82);
    padding: 18px;
  }

  .type-summary p {
    margin: 8px 0 0;
    color: var(--muted);
  }

  .profile-lens,
  .comparison-panel,
  .cycle-panel {
    margin: 36px 0;
  }

  .lens-grid,
  .comparison-grid {
    display: grid;
    gap: 14px;
  }

  .lens-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .lens-grid div,
  .comparison-grid div,
  .cycle-panel {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(255, 250, 241, 0.82);
    padding: 18px;
  }

  .lens-grid span {
    display: block;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .lens-grid strong {
    display: block;
    margin-top: 8px;
    color: var(--wine);
    line-height: 1.55;
  }

  .comparison-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .comparison-grid h3 {
    margin: 0 0 8px;
    font-size: 1.08rem;
  }

  .comparison-grid p,
  .cycle-panel li {
    color: var(--muted);
    line-height: 1.7;
  }

  .cycle-panel ol {
    margin: 12px 0 0;
  }

  @media (max-width: 720px) {
    .type-summary,
    .lens-grid,
    .comparison-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
