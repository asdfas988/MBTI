---
import { navigation, site } from "@/data/site";
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${site.name} 首页`}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span>{site.name}</span>
    </a>
    <nav class="nav" aria-label="主导航">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--line);
    background: rgba(247, 241, 232, 0.9);
    backdrop-filter: blur(16px);
  }

  .header-inner {
    display: flex;
    min-height: 72px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 1.28rem;
    font-weight: 800;
  }

  .brand-mark {
    width: 28px;
    height: 28px;
    border: 2px solid var(--ink);
    border-radius: 50% 50% 4px 4px;
    background:
      linear-gradient(var(--gold), var(--gold)) center 7px / 4px 14px no-repeat,
      linear-gradient(var(--ink), var(--ink)) center bottom / 15px 5px no-repeat,
      var(--mist);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: end;
    gap: 6px;
  }

  .nav a {
    border-radius: 6px;
    padding: 9px 11px;
    color: #394f46;
    font-size: 0.94rem;
  }

  .nav a:hover,
  .nav a:focus-visible {
    background: rgba(37, 67, 58, 0.08);
    outline: none;
  }

  @media (max-width: 760px) {
    .header-inner {
      align-items: start;
      flex-direction: column;
      padding: 14px 0;
    }

    .nav {
      justify-content: start;
    }
  }
</style>
