---
interface Props {
  title: string;
  description: string;
  href: string;
  label?: string;
}

const { title, description, href, label } = Astro.props;
---

<a class="topic-card card card-pad" href={href}>
  {label && <span class="eyebrow">{label}</span>}
  <h3>{title}</h3>
  <p>{description}</p>
  <span class="arrow" aria-hidden="true">-></span>
</a>

<style>
  .topic-card {
    position: relative;
    min-height: 190px;
    overflow: hidden;
  }

  .topic-card::after {
    content: "";
    position: absolute;
    right: -28px;
    bottom: -30px;
    width: 120px;
    height: 120px;
    border: 1px solid rgba(37, 67, 58, 0.18);
    border-radius: 50%;
  }

  h3 {
    margin: 12px 0 10px;
    font-size: 1.25rem;
  }

  p {
    margin: 0;
    color: var(--muted);
    line-height: 1.75;
  }

  .arrow {
    display: inline-block;
    margin-top: 22px;
    color: var(--wine);
    font-weight: 800;
  }
</style>
