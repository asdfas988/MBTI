---
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  category?: string;
  pubDate?: Date;
  readingMinutes?: number;
}

const { title, description, category, pubDate, readingMinutes } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <main class="article-page">
    <section class="container article-hero">
      <div class="article-intro">
        {category && <p class="eyebrow">{category}</p>}
        <h1>{title}</h1>
        <p class="lead">{description}</p>
        <div class="meta">
          {pubDate && <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString("zh-CN")}</time>}
          {readingMinutes && <span>约 {readingMinutes} 分钟阅读</span>}
        </div>
      </div>
      <div class="paper-figure" aria-hidden="true">
        <svg class="diagram-lines" viewBox="0 0 160 120" role="img">
          <path d="M20 80 C42 28, 84 28, 108 70 S142 96, 150 32" fill="none" stroke="#6e2f44" stroke-width="3" />
          <circle cx="20" cy="80" r="6" fill="#25433a" />
          <circle cx="108" cy="70" r="6" fill="#b99b5f" />
          <circle cx="150" cy="32" r="6" fill="#6e2f44" />
        </svg>
      </div>
    </section>
    <section class="container content-grid">
      <article class="prose article-body">
        <slot />
      </article>
      <aside class="toc card card-pad" aria-label="延伸阅读">
        <strong>相关概念</strong>
        <a href="/concepts/projection/">投射</a>
        <a href="/concepts/transference/">移情</a>
        <a href="/concepts/repetition-compulsion/">重复强迫</a>
        <div class="site-disclaimer">
          本文用于心理学学习与自我理解，不用于临床诊断或治疗。
        </div>
      </aside>
    </section>
  </main>
</BaseLayout>

<style>
  .article-page {
    padding-top: 34px;
  }

  .article-hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 34px;
    align-items: center;
    padding: 38px 0 26px;
  }

  h1 {
    margin: 12px 0;
    font-size: clamp(2.2rem, 5vw, 4.8rem);
    line-height: 1.06;
  }

  .lead {
    max-width: 690px;
    color: var(--muted);
    font-size: 1.12rem;
    line-height: 1.9;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .content-grid {
    display: grid;
    grid-template-columns: minmax(0, 760px) 270px;
    gap: 42px;
    align-items: start;
    padding-top: 30px;
  }

  .article-body {
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }

  .toc {
    position: sticky;
    top: 96px;
  }

  .toc strong,
  .toc a {
    display: block;
  }

  .toc a {
    margin-top: 12px;
    color: var(--wine);
    font-weight: 700;
  }

  @media (max-width: 920px) {
    .article-hero,
    .content-grid {
      grid-template-columns: 1fr;
    }

    .toc {
      position: static;
    }
  }
</style>
